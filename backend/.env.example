APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Development defaults only. Use a secret manager for deployed credentials.
DATABASE_URL=postgresql+asyncpg://marp:change-me-local-only@localhost:5432/marp
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=marp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marp

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5176
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Server-side only. Never expose NVIDIA_API_KEY through frontend/admin configuration.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Enable only for a NIM deployment that supports response_format=json_object.
NVIDIA_JSON_MODE=false
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=8192
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_DEFAULT_SLIDE_COUNT=10
AI_DEFAULT_TONE=professional

STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
SOURCE_CONTEXT_CHARS=24000
INGESTION_TIMEOUT_SECONDS=60

# Visual provider credentials stay server-side. Enable providers through visuals admin settings.
MEDIA_DIR=./data/media
MAX_MEDIA_MB=8
VISUAL_BUDGET_SECONDS=45
PIXABAY_API_KEY=
STABILITY_API_KEY=
