APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Development defaults only. Use a secret manager for deployed credentials.
DATABASE_URL=postgresql+asyncpg://marp:change-me-local-only@localhost:5432/marp
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=marp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marp

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5176
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Reserved for a later phase; never sent to the frontend or used in Phase 1.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
