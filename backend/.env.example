APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://marp:change-me-local-only@localhost:5432/marp
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://localhost:5176
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test
MAX_REQUEST_MB=32
AI_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=25
MAX_MEDIA_MB=8
SOURCE_CONTEXT_CHARS=24000
INGESTION_TIMEOUT_SECONDS=60
VISUAL_BUDGET_SECONDS=45

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_JSON_MODE=false
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=8192
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_DEFAULT_SLIDE_COUNT=10
AI_DEFAULT_TONE=professional

PIXABAY_API_KEY=
STABILITY_API_KEY=
